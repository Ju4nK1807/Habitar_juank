{
  "expo": {
    "name": "Habita",
    "slug": "habita",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.habita.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBF8F4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "co.habita.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Habita usa la cámara para fotografiar el muro donde irá el mueble."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Habita usa tus fotos para elegir el espacio o una referencia de estilo.",
          "cameraPermission": "Habita usa la cámara para fotografiar el muro donde irá el mueble."
        }
      ]
    ],
    "scheme": "habita",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3dc95a6b-2f11-4c94-988d-e56845baf361"
      }
    },
    "owner": "eldiab",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3dc95a6b-2f11-4c94-988d-e56845baf361"
    }
  }
}
